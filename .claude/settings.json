{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(python3 -m pytest:*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./backend/.env.*)",
      "Read(./**/.env)",
      "Read(**/.env)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
